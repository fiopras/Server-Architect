# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DISCORD_TOKEN: Bot Token from Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# DISCORD_PUBLIC_KEY: Ed25519 Public Key from Discord Developer Portal -> General Information
DISCORD_PUBLIC_KEY="YOUR_DISCORD_PUBLIC_KEY"

# DISCORD_APPLICATION_ID: Application ID from Discord Developer Portal -> General Information
DISCORD_APPLICATION_ID="YOUR_DISCORD_APPLICATION_ID"

# GUILD_ID: Target Discord Server ID ("The Boomers" server ID) for instant Slash Command updates
GUILD_ID="YOUR_DISCORD_GUILD_ID"

# APP_URL: The URL where this applet or Vercel deployment is hosted
APP_URL="MY_APP_URL"

